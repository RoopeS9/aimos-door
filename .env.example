# Placeholders only. Actual values belong in private .env or server environment.
VALIO_API_KEY=
# Selected production/test bot: Verda DeepSeek Flash.
AGENT_PROVIDER=openai_compatible
AGENT_BASE_URL=https://inference.verda.com/v1
AGENT_API_KEY=
AGENT_MODEL=deepseek-4-1-flash-1017
# A failed or timed-out visitor inference retries the primary once, then falls
# back once to this same-provider model. There is no retry loop.
AGENT_FALLBACK_MODEL=kimi-k3-1-pro
# Each inference uses max_tokens=800. Warm-ups stop after 30 idle minutes and
# do not count against MODEL_DAILY_CAP; visitor retries and fallback calls do.
AGENT_WARMUP_ENABLED=1

# Optional product-type decisions and dedicated OpenRouter bot credentials.
OPENROUTER_API_KEY=
# Alternative: replace AGENT_PROVIDER above with openrouter and remove the
# Verda AGENT_MODEL override, or set an exact OpenRouter model slug.
# Alternative: replace provider/model above for Anthropic:
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AGENT_MODEL=claude-opus-5-5
DECISION_MODEL=typesafe/jev-1.14
MODEL_DAILY_CAP=300
BOT_CHAT_RATE_LIMIT=20
BOT_CHAT_RATE_WINDOW_SECONDS=60

# Simulated buyer login, not production authentication.
BUYER_SESSION_TTL_SECONDS=28800

DATA_DIR=data
PUBLIC_BASE_URL=https://door.example.com
DOOR_API_BASE_URL=http://127.0.0.1:8000
DOOR_PORT=8650

# Empty means the requested public demo has no separate demo-access-code wall.
# Human mutations still need the simulated X-Buyer-Session login credential.
DEMO_ACCESS_CODE=
# Reset the shared public demo after 20 quiet minutes. Health checks, static
# assets, and model warm-ups do not count as activity or trigger the reset.
# A presenter running the demo on their own laptop should set this to 0.
DEMO_IDLE_RESET_MINUTES=20
DEMO_RATE_LIMIT=120
# Wrong access codes per address before a lockout, and its length in seconds.
DEMO_ACCESS_MAX_FAILURES=10
DEMO_ACCESS_LOCKOUT_SECONDS=600
# Behind a Cloudflare Tunnel set this to Cf-Connecting-Ip so limits apply per visitor.
CLIENT_IP_HEADER=
DEMO_RATE_WINDOW_SECONDS=60
# Optional private ES256 P-256 PEM; otherwise generated and persisted.
# DOOR_SIGNING_KEY=
